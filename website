                backgroundColor: [
                    'rgba(148, 163, 184, 0.6)', // Slate for water
                    'rgba(167, 243, 208, 0.8)', // Light green for lymph
                    'rgba(253, 224, 71, 0.8)',  // Yellow/milky for chyle
                    'rgba(239, 68, 68, 0.8)'    // Red for blood
                ],
                borderColor: [
                    'rgb(100, 116, 139)',
                    'rgb(5, 150, 105)',
