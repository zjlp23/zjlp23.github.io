    // --- Chart 2: Viscosity Comparison ---
    const ctxVisc = document.getElementById('viscosityChart').getContext('2d');
    const viscChart = new Chart(ctxVisc, {
        type: 'bar',
        data: {
            labels: ['Water', 'Peripheral Lymph', 'Thoracic Duct Chyle', 'Whole Blood'],
            datasets: [{
                label: 'Approx. Viscosity (Centipoise - cP)',
